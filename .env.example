SEEKFLUX_ENV=local
# 可选：国外下载源较慢时使用本机 HTTP/HTTPS 代理，例如 Clash：
# SEEKFLUX_DOWNLOAD_PROXY=http://127.0.0.1:7890
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=seekflux
POSTGRES_USER=seekflux
POSTGRES_PASSWORD=seekflux_local
POSTGRES_PORT=5432
REDIS_PORT=6379
REDIS_IMAGE=redis:8.2-alpine
KAFKA_PORT=9092
KAFKA_IMAGE=apache/kafka:4.3.1
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.19.0
# 如果镜像同步了 macOS ARM64 tar 包，可在 .env 中覆盖完整下载地址：
# ELASTICSEARCH_DOWNLOAD_URL=https://mirror.example/elasticsearch-8.19.0-darwin-aarch64.tar.gz
RECOMMENDATION_CURSOR_SECRET=seekflux-local-cursor-secret-change-me
RECOMMENDATION_SOURCE_TIMEOUT_MS=250
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9002
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-04-16T18-13-26Z
MINIO_ROOT_USER=seekflux
MINIO_ROOT_PASSWORD=seekflux_local_secret
ONLINE_SERVER_PORT=8080
CONTENT_SERVER_PORT=8081
WEB_SERVER_PORT=3001
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.132.0
PROMETHEUS_PORT=9090
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0
GRAFANA_PORT=3000
GRAFANA_IMAGE=grafana/grafana:12.1.0
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=seekflux_local
FLINK_IMAGE=flink:2.1.3-scala_2.12-java17
