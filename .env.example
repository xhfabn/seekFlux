SEEKFLUX_ENV=local
# 可选：国外下载源较慢时使用本机 HTTP/HTTPS 代理，例如 Clash：
# SEEKFLUX_DOWNLOAD_PROXY=http://127.0.0.1:7890
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=seekflux
POSTGRES_USER=seekflux
POSTGRES_PASSWORD=seekflux_local
POSTGRES_PORT=5432
REDIS_PORT=6379
REDIS_IMAGE=redis:8.2-alpine
KAFKA_PORT=9092
KAFKA_IMAGE=apache/kafka:4.3.1
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.19.0
# 如果镜像同步了 macOS ARM64 tar 包，可在 .env 中覆盖完整下载地址：
# ELASTICSEARCH_DOWNLOAD_URL=https://mirror.example/elasticsearch-8.19.0-darwin-aarch64.tar.gz
RECOMMENDATION_CURSOR_SECRET=seekflux-local-cursor-secret-change-me
RECOMMENDATION_SOURCE_TIMEOUT_MS=250
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9002
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-04-16T18-13-26Z
MINIO_ROOT_USER=seekflux
MINIO_ROOT_PASSWORD=seekflux_local_secret
# 可选：真实媒体导入。密钥只写本地 .env，不提交仓库。
PIXABAY_API_KEY=
MINIO_PUBLIC_BASE=http://127.0.0.1:9000
MEDIA_BUCKET=seekflux-media
MEDIA_UPLOAD_MAX_BYTES=536870912
ONLINE_SERVER_PORT=8080
CONTENT_SERVER_PORT=8081
AGENT_SERVER_PORT=8083
AGENT_REQUEST_TIMEOUT_MS=2500
AGENT_LLM_PROVIDER=deterministic
# OpenAI-compatible provider：把 provider 改为 openai-compatible，并配置完整 chat/completions URL。
# AGENT_LLM_ENDPOINT=https://api.example.com/v1/chat/completions
# AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=gpt-4.1-mini
AGENT_LLM_TIMEOUT_MS=1800
# 真实 Provider 的美元/百万 token 单价；为 0 时仍记录 token，但成本为 0。
AGENT_LLM_INPUT_USD_PER_MILLION_TOKENS=0
AGENT_LLM_OUTPUT_USD_PER_MILLION_TOKENS=0
AGENT_MODEL_MAX_CONCURRENCY=4
AGENT_TOOL_MAX_CONCURRENCY=8
AGENT_CANCEL_SIGNAL_TTL_SECONDS=30
AGENT_CANCEL_POLL_INTERVAL_MS=100
AGENT_SHUTDOWN_GRACE_MS=5000
AGENT_SHADOW_ENABLED=false
AGENT_SHADOW_SAMPLE_RATE=0.0
AGENT_SHADOW_CANDIDATE_VERSION=deterministic-shadow-v1
AGENT_SHADOW_QUEUE_CAPACITY=20
WEB_SERVER_PORT=3001
# 跨模态检索默认关闭；先按 tools/multimodal/README.md 启动 SigLIP 服务再开启。
MULTIMODAL_ENABLED=false
MULTIMODAL_MODEL_ENDPOINT=http://127.0.0.1:8090
MULTIMODAL_MODEL_PORT=8090
MULTIMODAL_MODEL_ID=google/siglip2-base-patch16-224
MULTIMODAL_DIMENSIONS=768
MULTIMODAL_INDEX=seekflux-media-segments-v2
MULTIMODAL_MAX_VIDEO_SEGMENTS=12
MULTIMODAL_QUERY_SEGMENTS=8
# OCR/ASR 默认随多模态服务开启；视觉描述模型额外占用约 1GB，按需开启。
MULTIMODAL_OCR_ENABLED=true
MULTIMODAL_ASR_ENABLED=true
MULTIMODAL_ASR_MODEL_ID=small
MULTIMODAL_CAPTION_ENABLED=false
MULTIMODAL_CAPTION_MODEL_ID=Salesforce/blip-image-captioning-base
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.132.0
PROMETHEUS_PORT=9090
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0
GRAFANA_PORT=3000
GRAFANA_IMAGE=grafana/grafana:12.1.0
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=seekflux_local
FLINK_IMAGE=flink:2.1.3-scala_2.12-java17
