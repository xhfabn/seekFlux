{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seekflux.local/schemas/events/content-submitted-v2.schema.json",
  "title": "Content Submitted v2 Payload",
  "type": "object",
  "required": [
    "content_id", "creator_id", "content_type", "media_uri", "asset_uris", "title",
    "description", "body", "source_tags", "source_provider", "external_id",
    "source_page_uri", "source_author", "license_name"
  ],
  "properties": {
    "content_id": {"type": "string", "format": "uuid"},
    "creator_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "content_type": {"enum": ["VIDEO", "ARTICLE"]},
    "media_uri": {"type": "string", "minLength": 1, "maxLength": 2048},
    "asset_uris": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "maxLength": 2048}},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "description": {"type": "string", "maxLength": 4000},
    "body": {"type": "string", "maxLength": 100000},
    "source_tags": {"type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
    "source_provider": {"type": "string", "maxLength": 64},
    "external_id": {"type": "string", "maxLength": 256},
    "source_page_uri": {"type": "string", "maxLength": 2048},
    "source_author": {"type": "string", "maxLength": 128},
    "license_name": {"type": "string", "maxLength": 128}
  },
  "additionalProperties": false
}
