{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seekflux.io/contracts/events/agent-context-compaction-v1.schema.json",
  "title": "SeekFlux Agent context compaction summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "summaryId",
    "sessionId",
    "fromExclusive",
    "inclusiveCutoff",
    "strategyVersion",
    "summary",
    "estimatedTokens",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "summaryId": {"type": "string", "format": "uuid"},
    "sessionId": {"type": "string", "minLength": 1},
    "fromExclusive": {"type": "integer", "minimum": 0},
    "inclusiveCutoff": {"type": "integer", "minimum": 1},
    "strategyVersion": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "estimatedTokens": {"type": "integer", "minimum": 1},
    "createdAt": {"type": "string", "format": "date-time"}
  }
}
