# 本地只运行业务代码；这些中间件实际运行在服务器。
# 首次使用 ./seekflux.sh remote-init 创建私有配置；填入密码后即可直连。
# 已有服务器 SSH 权限时可用 remote-init --from-server 自动获取当前容器凭据。
SEEKFLUX_REMOTE_HOST=36.140.162.30
SEEKFLUX_REMOTE_USER=root
SEEKFLUX_REMOTE_SSH_PORT=22
SEEKFLUX_REMOTE_PROJECT=/opt/seekFlux
SEEKFLUX_REMOTE_COMPOSE_PROJECT=seekflux
SEEKFLUX_REMOTE_POSTGRES_PORT=5432
SEEKFLUX_REMOTE_REDIS_PORT=6379
SEEKFLUX_REMOTE_KAFKA_PORT=9092
SEEKFLUX_REMOTE_ELASTICSEARCH_PORT=9200
SEEKFLUX_REMOTE_MINIO_PORT=9000
POSTGRES_DB=seekflux
POSTGRES_USER=seekflux
POSTGRES_PASSWORD=
MINIO_ROOT_USER=seekflux
MINIO_ROOT_PASSWORD=
# 留空时使用 http://服务器地址:MinIO端口。
MINIO_PUBLIC_BASE=
# 可在这里覆盖 .env.example 的业务配置，例如模型 Provider；不要把密码提交到 Git。
MULTIMODAL_ENABLED=false
# SeekFlux 的 Agent Server 已手工装配 Runtime，关闭公共库的重复自动装配。
SEEKFLUX_AGENT_RUNTIME_ENABLED=false
